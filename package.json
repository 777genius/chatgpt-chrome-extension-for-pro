{
  "name": "chatgpt-chrome-extension-for-pro",
  "version": "1.6.1",
  "private": true,
  "description": "Chrome extension for ChatGPT completion alerts, guarded retries and conversation handoffs.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "bun@1.4.3",
  "engines": {
    "node": ">=26.0.0",
    "bun": "1.4.3"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "test": "node scripts/test.ts",
    "memory": "node scripts/chrome-memory.ts",
    "test:retry": "node tests/check.ts",
    "test:handoff": "node tests/handoff-check.ts",
    "typecheck": "tsc --noEmit",
    "check:syntax": "node scripts/syntax.ts",
    "check": "bun run build && bun run check:syntax && bun run check:built && bun run typecheck && bun run test && bun run test:distribution && bun run foundation:check && bun run foundation:assert-dev-only && bun run foundation:assert-registry",
    "foundation:check": "agent-teams-foundation check",
    "foundation:status": "agent-teams-foundation status",
    "foundation:attach": "agent-teams-foundation attach",
    "foundation:detach": "agent-teams-foundation detach",
    "foundation:assert-dev-only": "agent-teams-foundation assert-dev-only",
    "foundation:assert-registry": "agent-teams-foundation assert-registry",
    "check:built": "bun scripts/check-build.ts",
    "check:changed": "agent-teams-foundation agent-workflow check-changed --consumer .",
    "check:fast": "bun run build && bun run check:built && bun run typecheck && bun run test",
    "test:distribution": "bun scripts/test-distribution.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "linkedom": "0.18.15",
    "typescript": "7.0.2",
    "@get-modular/conformance": "0.5.1",
    "@agent-teams/engineering-foundation": "3.1.0"
  },
  "dependencies": {
    "@get-modular/core": "0.7.1",
    "@get-modular/assembly": "0.7.1",
    "@get-modular/resources": "0.2.1",
    "@get-modular/observation": "0.2.0"
  }
}
