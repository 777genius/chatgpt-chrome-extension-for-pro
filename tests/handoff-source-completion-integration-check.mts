import assert from 'node:assert/strict';import{readFileSync}from'node:fs';import{createRequire}from'node:module';import{createContext,runInContext}from'node:vm';
const require=createRequire(import.meta.url);require('../extension/goal-policy.js');const {create}=require('../extension/goal-store.js');
const worker=readFileSync('extension/service-worker.js','utf8'),start=worker.indexOf('async function reconcileWaitingGoalAnswer('),end=worker.indexOf('async function reconcileGoalPreparation(',start);assert.ok(start>0&&end>start);
const url='https://chatgpt.com/c/source-integration',oldKey='/c/source-integration|old',newKey='/c/source-integration|latest',reason='В исходном чате идёт генерация; переход отменён';
async function fixture(response:string,mutate=false){
 const now=Date.now(),data:Record<string,any>={['chatgpt-goal:'+url]:{id:'goal-id',url,goal:'Complete fixture',rules:'',phase:'blocked',reason:'Передача Goal остановлена: '+reason,handoffId:'handoff-id',handoffTabId:7,preHandoffPhase:'waiting',expectedPromptKey:oldKey,deadlineAt:now+60000,continuations:0,maxContinuations:30},
  handoff:{id:'handoff-id',stage:'failed',reason,sourceUrl:url,lastUserText:'original retry'}};
 const native={ok:true,url,isLatest:true,isReadOnly:false,generating:false,hasError:false,turnStatus:'complete',assistantCompleted:true,assistantPhase:'final_answer',assistantKey:'answer',promptKey:newKey,userId:'user-id',userText:'original retry',userSentAtMs:100000,goalResponse:response,goalRawExact:response==='GOAL_COMPLETE'};
 const events:any[]=[{kind:'request.started',tabId:7,sourceUrl:url,operationId:'retry-id',requestId:'request-id',eventAt:100000},{kind:'send.dispatched',tabId:7,operationId:'retry-id',text:'original retry'},{kind:'retry.confirmed',tabId:7,operationId:'retry-id'},{kind:'request.failed',tabId:7,operationId:'retry-id',requestId:'request-id'},{kind:'handoff.navigating',tabId:7,operationId:'handoff-id',sourceUrl:url},{kind:'handoff.failed',tabId:7,operationId:'handoff-id',reason}].map((x,i)=>({...x,sequence:i+1}));
 let probes=0;const sends:any[]=[],journal:any[]=[];
 const storage={get:async(k:string|string[])=>Object.fromEntries((Array.isArray(k)?k:[k]).filter(x=>data[x]!==undefined).map(x=>[x,structuredClone(data[x])])),set:async(v:any)=>Object.assign(data,structuredClone(v))};
 const tabs={get:async()=>({id:7,url}),sendMessage:async(_id:number,m:any)=>{sends.push(m);return {ok:true};}};
 const goalController=create({storage,tabs,appendJournal:async(e:any)=>{journal.push(e);return{ok:true};},now:()=>now,uuid:()=> 'new-operation'});
 const ctx=createContext({Date,JSON,Number,Object,Array,URL,goalController,handoffKey:()=> 'handoff',inspectCompletedTurn:()=>{},ChatGPTGoalPolicy:{canonical:(v:string)=>v},readJournal:async()=>({ok:true,storageError:'',meta:{sequence:events.length},events:structuredClone(events)}),chrome:{storage:{local:storage},tabs,scripting:{executeScript:async()=>{probes++;if(mutate&&probes===2)data['chatgpt-goal:'+url].stopRequested=true;return[{result:structuredClone(native)}];}}}});
 runInContext(worker.slice(start,end),ctx);const run=()=>runInContext(`reconcileCompletedSourceHandoff(7,${JSON.stringify(url)})`,ctx);const result=await run();return{result,run,data,sends,journal};
}
const completed=await fixture('GOAL_COMPLETE');assert.equal(completed.result.ok,true);assert.equal(completed.data['chatgpt-goal:'+url].phase,'completed');assert.equal(completed.sends.length,0,'completed Goal sends nothing');
const continuing=await fixture('Still working');assert.equal(continuing.result.ok,true);assert.equal(continuing.data['chatgpt-goal:'+url].phase,'preparing');assert.equal(continuing.sends.length,1,'one continuation is dispatched');assert.equal(continuing.sends[0].type,'CHATGPT_GOAL_DISPATCH');await continuing.run();assert.equal(continuing.sends.length,1,'re-observation does not dispatch again');
const stopped=await fixture('Still working',true);assert.equal(stopped.data['chatgpt-goal:'+url].phase,'blocked');assert.equal(stopped.sends.length,0,'owner stop during inspection wins');
console.log('Historical handoff recovery integration: real coordinator handles complete, one continuation, duplicate observation and owner-stop race.');
