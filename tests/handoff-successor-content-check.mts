import assert from 'node:assert/strict';import{readFileSync}from'node:fs';import{createContext,runInContext}from'node:vm';
const source=readFileSync('extension/content-script.js','utf8'),from=source.indexOf('  async function resolveHandoffSuccessor('),until=source.indexOf('  async function beginHandoff(',from);assert.ok(from>0&&until>from);
const helper=source.slice(from,until),url='https://chatgpt.com/c/source-fixture';
async function check(result:any,alive=true){const calls:any[]=[],old={id:'old',stage:'awaiting-confirmation'};const ctx=createContext({handoffRecord:old,runtimeMessage:async(m:any)=>{calls.push(m);return result}});runInContext(helper,ctx);let error='';try{await runInContext(`resolveHandoffSuccessor(${JSON.stringify(url)},()=>${alive})`,ctx)}catch(e){error=String(e)}return {ctx,calls,error,old};}
const resolved=await check({ok:true,record:{id:'old',stage:'superseded'}});assert.equal(resolved.error,'');assert.equal(resolved.ctx.handoffRecord.stage,'superseded');assert.equal(resolved.calls.length,1);assert.equal(resolved.calls[0].type,'CHATGPT_HANDOFF_SUCCESSOR');assert.equal(Object.keys(resolved.calls[0]).sort().join(','),'type,url','page cannot self-certify native receipt or request IDs');
for(const result of [{ok:false,reason:'Unknown outcome'},undefined]){const failed=await check(result);assert.ok(failed.error);assert.equal(failed.ctx.handoffRecord,failed.old,'refused predecessor remains fenced');}
const switched=await check({ok:true,record:{id:'old',stage:'superseded'}},false);assert.ok(switched.error);assert.equal(switched.ctx.handoffRecord,switched.old,'late worker reply cannot change a different source');
const begin=source.slice(until,source.indexOf('  function notifySuppressedError',until));assert.ok(begin.indexOf('await resolveHandoffSuccessor(')<begin.indexOf("type: 'CHATGPT_HANDOFF_BEGIN'"));assert.ok(begin.indexOf('await resolveHandoffSuccessor(')<begin.indexOf("type:'CHATGPT_GOAL_CONTEXT'"),'migrate proven predecessor Goal before copying new handoff context');
console.log('New-chat terminal error: worker-owned predecessor successor check, refusal and route-race fences, no self-certified payload or direct click passed.');
