import assert from 'node:assert/strict';
import {readFileSync} from 'node:fs';
import {createContext,runInContext} from 'node:vm';
import {parseHTML} from 'linkedom';
interface State {ok:boolean;url:string;revision:number;status:null|{kind:'error'|'success'|'loading';eventAt:number;unread?:boolean}}
interface Indicator {tick(value:{url:string;frame:number}):boolean;accept(state:State):boolean;refresh():Promise<void>;dispose():void;loadingStartedAt():number|null}
interface Factory {create(options:unknown):Indicator}
const source=readFileSync('extension/status-indicator.js','utf8');
const {document,window}=parseHTML('<html><head><link rel="shortcut&#9;ICON  alternate" href="native.ico"><link rel="icon" href="stale-status.svg" data-chatgpt-notifier-status></head><body></body></html>');
const native=document.querySelector('link')!;
const originalRel=native.getAttribute('rel');
const stale=document.querySelector('[data-chatgpt-notifier-status]')!;
let nativeRelWrites=0;
const setNative=native.setAttribute.bind(native);
native.setAttribute=(name:string,value:string)=>{if(name==='rel')nativeRelWrites++;setNative(name,value);};
let url='https://chatgpt.com/c/alpha',alive=true;
const pending:Array<{url:string;resolve:(value:State)=>void}>=[];
const world=createContext({URL});runInContext(source,world);
const indicator=(world.ChatGPTStatusIndicator as Factory).create({document,getUrl:()=>url,alive:()=>alive,
 load:(requested:string)=>new Promise<State>(resolve=>pending.push({url:requested,resolve}))});
const state=(kind:'error'|'success'|'loading'|null,revision:number,chat=url):State=>({ok:true,url:chat,revision,status:kind?{kind,eventAt:revision*1000}:null});
const tick=()=>new Promise<void>(resolve=>setImmediate(resolve));
const owned=()=>document.querySelector('link[data-chatgpt-notifier-status]');
pending.shift()!.resolve(state('error',1));await tick();
assert.equal(stale.isConnected,false,'creation removes only stale owned metadata links');
assert.equal(stale.hasAttribute('data-chatgpt-notifier-status-retired'),true);
assert.ok(owned());
assert.equal(decodeURIComponent(owned()!.getAttribute('href')!.split(',')[1]),readFileSync('extension/icons/status-error.svg','utf8').trim());
assert.equal(native.getAttribute('href'),'native.ico');
assert.equal(native.getAttribute('rel'),'shortcut\t  alternate','only the case-insensitive icon token is masked');
assert.equal(native.isConnected,true,'native React-managed nodes remain connected');
assert.equal(indicator.loadingStartedAt(),null);
const visit=indicator.refresh();pending.shift()!.resolve(state('error',1));await visit;
assert.ok(owned(),'visiting does not acknowledge the indicator');
assert.equal(indicator.accept(state('success',2)),true);await tick();
assert.equal(decodeURIComponent(owned()!.getAttribute('href')!.split(',')[1]),readFileSync('extension/icons/status-success.svg','utf8').trim());
const replacement=document.createElement('link');replacement.rel='icon';replacement.href='new-native.ico';document.head.append(replacement);await tick();
assert.equal(replacement.getAttribute('rel'),'');
assert.equal(document.head.querySelectorAll('link[rel~="icon"]').length,1,'status is the sole favicon candidate');
assert.equal(document.head.querySelector('link[rel~="icon"]'),owned());
replacement.setAttribute('rel','shortcut ICON');replacement.href='updated-native.ico';await tick();
assert.equal(replacement.getAttribute('rel'),'shortcut ','a replacement native icon declaration is masked again');
const repurposed=document.createElement('link');repurposed.rel='icon';repurposed.href='repurposed.ico';document.head.append(repurposed);await tick();
repurposed.setAttribute('rel','manifest');await tick();
const detached=document.createElement('link');detached.rel='icon shortcut';detached.href='removed.ico';document.head.append(detached);await tick();
assert.equal(detached.getAttribute('rel'),' shortcut');
detached.remove();await tick();assert.equal(detached.getAttribute('rel'),'icon shortcut','detached native references are restored and pruned promptly');
detached.setAttribute('rel','manifest');
assert.equal(document.querySelectorAll('[data-chatgpt-notifier-status]').length,1);
indicator.accept(state(null,3));await tick();assert.equal(owned(),null);
assert.equal(indicator.accept(state('error',2)),false,'late status cannot undo manual acknowledgement');
assert.equal(native.getAttribute('href'),'native.ico');assert.equal(native.getAttribute('rel'),originalRel,'idle restores the exact original rel as a fresh browser candidate');
assert.equal(replacement.href,'updated-native.ico');assert.equal(replacement.getAttribute('rel'),'shortcut ICON','idle restores the latest external icon declaration');
assert.equal(repurposed.getAttribute('rel'),'manifest','idle cannot undo a meaningful external non-icon declaration');repurposed.remove();
const oldRequest=indicator.refresh();const old=pending.shift()!;
url='https://chatgpt.com/c/beta';const newRequest=indicator.refresh();const next=pending.shift()!;
next.resolve(state('success',1));await newRequest;old.resolve(state('error',10,'https://chatgpt.com/c/alpha'));await oldRequest;
assert.match(decodeURIComponent(owned()!.getAttribute('href')!),/#16a34a/,'old chat response must not recolor current chat');
assert.equal(indicator.accept(state('error',20,'https://chatgpt.com/c/alpha')),false);
url='https://chatgpt.com/c/alpha';const back=indicator.refresh();pending.shift()!.resolve(state(null,3));await back;assert.equal(owned(),null);
indicator.accept(state('loading',4));await tick();
assert.equal(indicator.loadingStartedAt(),4000);
const firstFrame=owned()!.getAttribute('href');
assert.equal(indicator.tick({url,frame:1}),true);assert.notEqual(owned()!.getAttribute('href'),firstFrame,'loader really changes favicon frames');
assert.match(decodeURIComponent(owned()!.getAttribute('href')!),/#2563eb/);
assert.equal(indicator.tick({url:'https://chatgpt.com/c/other',frame:2}),false);
assert.equal(indicator.tick({url,frame:8}),false);
const relWritesBeforeFrames=nativeRelWrites;
for(let frame=0;frame<16;frame++){assert.equal(indicator.tick({url,frame:frame%8}),true);await tick();}
assert.equal(nativeRelWrites,relWritesBeforeFrames,'animation observer callbacks do not rewrite native rel or loop');
const beforeGetter=owned()!.getAttribute('href');assert.equal(indicator.loadingStartedAt(),4000);assert.equal(owned()!.getAttribute('href'),beforeGetter,'loading timestamp getter has no DOM effects');
indicator.accept(state('success',5));const completed=owned()!.getAttribute('href');
assert.equal(indicator.loadingStartedAt(),null);
assert.equal(indicator.tick({url,frame:3}),false);assert.equal(owned()!.getAttribute('href'),completed,'late animation tick cannot overwrite a completed response');
alive=false;replacement.href='again.ico';await tick();assert.equal(owned(),null,'invalidated runtime disposes old icon observer');
assert.equal(indicator.accept(state('success',6)),false);indicator.dispose();
assert.equal(document.querySelectorAll('link').length,2,'native favicon links are preserved');
assert.equal(native.getAttribute('rel'),originalRel);assert.equal(replacement.getAttribute('rel'),'shortcut ICON');
assert.equal(detached.getAttribute('rel'),'manifest','disposal never retains or overwrites a detached native node');
assert.equal(indicator.loadingStartedAt(),null);
console.log('Status favicon: sole candidate masking, exact restoration, native replacements/repurposing, detached pruning, frames, SPA races and disposal passed.');
// document_start may run before head exists. Bootstrap observes only until head
// appears, then scopes observation to head so conversation mutations cost nothing.
const early=parseHTML('<html><head></head><body></body></html>');early.document.head.remove();
let lateHead:ReturnType<typeof early.document.createElement>|null=null;
Object.defineProperty(early.document,'head',{get:()=>lateHead,configurable:true});
const earlyWorld=createContext({URL});runInContext(source,earlyWorld);
const earlyIndicator=(earlyWorld.ChatGPTStatusIndicator as Factory).create({document:early.document,getUrl:()=>url,load:async()=>state('error',1)});
await tick();assert.equal(early.document.querySelector('[data-chatgpt-notifier-status]'),null);
const head=early.document.createElement('head');lateHead=head;early.document.documentElement.prepend(head);await tick();
assert.ok(head.querySelector('[data-chatgpt-notifier-status]'),'status appears when head becomes available');
earlyIndicator.dispose();
const shared=parseHTML('<html><head><link rel="ICON" href="shared-native.ico"></head><body></body></html>');
const sharedNative=shared.document.querySelector('link')!;
const firstOwner=(world.ChatGPTStatusIndicator as Factory).create({document:shared.document,getUrl:()=>url,load:async()=>state('loading',1)});
await tick();assert.equal(sharedNative.getAttribute('rel'),'');
const oldIcon=shared.document.querySelector('[data-chatgpt-notifier-status]')!;
const secondOwner=(world.ChatGPTStatusIndicator as Factory).create({document:shared.document,getUrl:()=>url,load:async()=>state('success',2)});
await tick();await tick();
assert.equal(oldIcon.isConnected,false);assert.equal(firstOwner.accept(state('error',99)),false,'a superseded owner disposes instead of recreating its stale link');
assert.equal(firstOwner.loadingStartedAt(),null);
assert.equal(shared.document.querySelectorAll('[data-chatgpt-notifier-status]').length,1);
secondOwner.dispose();await tick();assert.equal(sharedNative.getAttribute('rel'),'ICON');assert.equal(sharedNative.getAttribute('href'),'shared-native.ico');

const badges=parseHTML('<html><head><link rel="icon" href="badge-native.ico"></head><body></body></html>');
const badgeState=(kind:'error'|'success'|'loading',revision:number,unread:boolean):State=>({...state(kind,revision),status:{kind,eventAt:1000,unread}});
const badge=(world.ChatGPTStatusIndicator as Factory).create({document:badges.document,getUrl:()=>url,load:async()=>badgeState('error',1,true)});
await tick();
const badgeSVG=()=>decodeURIComponent(badges.document.querySelector('[data-chatgpt-notifier-status]')!.getAttribute('href')!.split(',')[1]);
const badgeCircle=()=>parseHTML(badgeSVG()).document.querySelector('circle[data-chatgpt-unread]');
assert.ok(badgeCircle());assert.equal(badgeCircle()!.getAttribute('fill'),'#2563eb');assert.equal(badgeCircle()!.getAttribute('stroke'),'white');
assert.ok(Number(badgeCircle()!.getAttribute('cx'))>=48&&Number(badgeCircle()!.getAttribute('cy'))<=16,'blue unread dot belongs in the top-right corner');
assert.match(badgeSVG(),/#dc2626/);assert.match(badgeSVG(),/M22 22l20 20/,'unread error preserves its cross');
badge.accept(badgeState('error',2,false));assert.equal(badgeCircle(),null);assert.equal(badgeSVG(),readFileSync('extension/icons/status-error.svg','utf8').trim(),'viewing retains the exact red base icon');
badge.accept(badgeState('success',3,true));assert.ok(badgeCircle());assert.match(badgeSVG(),/#16a34a/);assert.match(badgeSVG(),/M17 32l10 10/,'unread success preserves its check');
badge.accept(badgeState('success',4,false));assert.equal(badgeCircle(),null);assert.equal(badgeSVG(),readFileSync('extension/icons/status-success.svg','utf8').trim());
badge.accept(badgeState('loading',5,true));assert.equal(badgeCircle(),null,'loader never renders an unread dot');
badge.tick({url,frame:2});assert.equal(badgeCircle(),null);badge.dispose();
console.log('Unread badge: blue top-right dot on terminal icons only, view preserves base glyph/color, loader remains unchanged.');
