import assert from 'node:assert/strict';
import {readFileSync} from 'node:fs';
import {createContext,runInContext} from 'node:vm';
const storage:Record<string,unknown>={'chatgpt-status:migration':{schema:1}};
const ctx=createContext({Date,Math,chrome:{storage:{local:{get:async(key:string)=>structuredClone({[key]:storage[key]}),set:async(value:Record<string,unknown>)=>Object.assign(storage,structuredClone(value))}},notifications:{clear:async()=>true}}});
runInContext(readFileSync('extension/status-store.js','utf8'),ctx);
const evaluate=(code:string)=>runInContext(code,ctx) as Promise<any>;
await evaluate("globalThis.url='https://chatgpt.com/c/fixture';globalThis.card={phase:'pending',cardKey:'task-one',anchorKey:'turn-one',taskId:'synthetic'};globalThis.start=statusReceipt();markChatLoading(url,100,start)");
assert.equal((await evaluate('updateDeferredChat(url,card,statusReceipt())')).status.kind,'deferred','completed scheduler turn can show the pending task instead of an old request loader');
await evaluate("reserveChatNotification(url,7,'success',200,statusReceipt())");
assert.equal((await evaluate('readChatStatus(url)')).status.kind,'deferred','success of scheduling does not hide deferred work');
assert.equal((await evaluate("updateDeferredChat(url,{...card,phase:'unknown'},statusReceipt())")).status.kind,'deferred','unmounted card alone retains unknown waiting state');
await evaluate("reserveChatNotification(url,7,'error',300,statusReceipt())");
assert.equal((await evaluate('readChatStatus(url)')).status.kind,'error','a genuine later response error takes precedence over waiting');
await evaluate("updateDeferredChat(url,{...card,phase:'pending'},statusReceipt())");
assert.equal((await evaluate('readChatStatus(url)')).status.kind,'error','unchanged card observations cannot hide a newer response error');
await evaluate('globalThis.next=statusReceipt();markChatLoading(url,400,next)');
assert.equal((await evaluate('readChatStatus(url)')).status.kind,'loading','a real next request retires the old waiting card');
assert.equal((await evaluate('updateDeferredChat(url,card,statusReceipt())')).status.kind,'loading','a delayed old card cannot return after the next request');
await evaluate("globalThis.second={...card,cardKey:'task-two',anchorKey:'turn-two'};updateDeferredChat(url,second,statusReceipt())");
assert.equal((await evaluate('readChatStatus(url)')).status.kind,'deferred');
const resumed=await evaluate("updateDeferredChat(url,{...second,phase:'resumed',generating:true,startedAt:500},statusReceipt())");
assert.equal(resumed.status.kind,'loading','real native resumption replaces the clock with loading');
ctx.resumedReceipt=structuredClone(resumed.status.receipt);
assert.equal((await evaluate('stopChatLoading(url,500,statusReceipt(),resumedReceipt)')).status,null);
assert.equal((await evaluate("updateDeferredChat(url,{...second,phase:'resumed',generating:true,startedAt:500},statusReceipt())")).status,null,'duplicate resumption cannot revive a stopped generation');
await evaluate("globalThis.third={...card,cardKey:'task-three'};updateDeferredChat(url,third,statusReceipt())");
const beforeCancelledSend=await evaluate('readChatStatus(url)');
await evaluate('stopChatLoading(url,600,statusReceipt())');
const afterCancelledSend=await evaluate('readChatStatus(url)');
assert.deepEqual(afterCancelledSend,beforeCancelledSend,'an unbound cancelled retry cannot consume or hide a pending scheduled task');
assert.equal((await evaluate("updateDeferredChat(url,{...third,phase:'pending'},statusReceipt())")).status.kind,'deferred','the same card remains eligible after cancel-before-send');
assert.equal((await evaluate("updateDeferredChat(url,{...third,phase:'resumed',generating:true,startedAt:600},statusReceipt())")).status.kind,'loading','the genuine later scheduled continuation can still resume');
assert.equal((await evaluate("updateDeferredChat('https://chatgpt.com/c/other',card,statusReceipt())")).status.kind,'deferred');
assert.equal((await evaluate('readChatStatus(url)')).status.kind,'loading','another chat has independent waiting state');

await evaluate("globalThis.errorURL='https://chatgpt.com/c/newer-error';updateDeferredChat(errorURL,card,statusReceipt());reserveChatNotification(errorURL,7,'error',700,statusReceipt())");
assert.equal((await evaluate("updateDeferredChat(errorURL,{...card,phase:'resumed',generating:true,startedAt:800},statusReceipt())")).status.kind,'error','an old card resumption cannot replace a newer genuine error with observed loading');
await evaluate("globalThis.stopURL='https://chatgpt.com/c/old-stop';globalThis.stopReceipt=statusReceipt();globalThis.oldCardReceipt=statusReceipt();globalThis.newStart=statusReceipt();markChatLoading(stopURL,900,newStart);updateDeferredChat(stopURL,card,oldCardReceipt)");
assert.equal((await evaluate('stopChatLoading(stopURL,100,stopReceipt)')).status.kind,'loading','an older unbound stop cannot clear a newer request hidden behind a delayed card');
assert.equal((await evaluate('stopChatLoading(stopURL,100,statusReceipt())')).status.kind,'loading','a wrong generation ID cannot clear a newer real loading status even when its message arrives later');
await evaluate("globalThis.successURL='https://chatgpt.com/c/late-start';updateDeferredChat(successURL,card,statusReceipt());globalThis.delayedStart=statusReceipt();reserveChatNotification(successURL,7,'success',1000,statusReceipt())");
assert.equal((await evaluate('markChatLoading(successURL,950,delayedStart)')).status.kind,'success','a delayed real request start retires its older card even after the terminal response won the loading race');
assert.equal((await evaluate('updateDeferredChat(successURL,card,statusReceipt())')).status.kind,'success','the retired old card cannot return after that newer successful request');
await evaluate("globalThis.orderURL='https://chatgpt.com/c/observation-order';globalThis.staleNone=statusReceipt();globalThis.freshPending=statusReceipt();updateDeferredChat(orderURL,card,freshPending)");
assert.equal((await evaluate("updateDeferredChat(orderURL,{...card,phase:'none'},staleNone)")).status.kind,'deferred','a stale none event cannot clear a newer card observation');
await evaluate('globalThis.staleStop=statusReceipt();updateDeferredChat(orderURL,card,statusReceipt())');
assert.equal((await evaluate('stopChatLoading(orderURL,1100,staleStop)')).status.kind,'deferred','a stop captured before a later same-card observation cannot consume that card');
await evaluate("globalThis.legacyURL='https://chatgpt.com/c/legacy-card';reserveChatNotification(legacyURL,7,'success',1200,statusReceipt());updateDeferredChat(legacyURL,{...card,cardKey:'turn-one|legacy-task'},statusReceipt())");
assert.equal((await evaluate("updateDeferredChat(legacyURL,{...card,phase:'none',cardKey:'[\"turn-one\",\"\",0]',reason:'historical-card'},statusReceipt())")).status.kind,'success','a historical native card clears its old-format persisted clock after upgrade');
console.log('Deferred state: scheduler result, unknown card, real error, new request, resumed generation, stop races, legacy card identity and per-chat isolation passed.');
