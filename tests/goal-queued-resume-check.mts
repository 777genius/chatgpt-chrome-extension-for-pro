 const goal:any={id:'goal',phase:'blocked',reason:'Восстановление запроса завершилось ошибкой',resumeRequested:true,expectedPromptKey:prompt,deadlineAt:Date.now()+60000};
 const native:any={ok:true,isLatest:true,isReadOnly:false,turnStatus:'complete',generating:false,hasError:false,assistantCompleted:true,assistantPhase:'final_answer',assistantKey:'answer',userId:'user',promptKey:prompt,userSentAtMs:100001,userText:'text',goalResponse:'GOAL_COMPLETE',goalRawExact:true};
 const receipt:any={requestId:'request',startedAt:100000,submittedUserId:'user'};const events:any[]=[{kind:'request.started',tabId:7,sourceUrl:url,requestId:'request',eventAt:100000,sequence:1}];
 const x:any={goal,native,receipt,journal:{ok:true,storageError:'',events,meta:{sequence:1}},ready:{ok:true,idle:true},calls:[],route:url};mutate(x);
 const ctx=createContext({URL,Date,JSON,Number,Math,ChatGPTGoalPolicy:{canonical:(v:string)=>v},inspectCompletedTurn:()=>{},chrome:{tabs:{sendMessage:async()=>x.ready,get:async()=>({url:x.route})},scripting:{executeScript:async()=>[{result:structuredClone(x.native)}]}},latestRequestReceipt:async()=>structuredClone(x.receipt),readJournal:async()=>structuredClone(x.journal),goalController:{get:async()=>structuredClone(x.goal),resumeObserved:async()=>{x.calls.push('resumeObserved');x.goal.phase='waiting';return {ok:true}},completion:async(input:any)=>{x.calls.push('completion:'+input.response);return {ok:true}},control:async()=>{x.calls.push('control');return {ok:true}},manual:async()=>{x.calls.push('manual');return {ok:true}},manualBind:async()=>{x.calls.push('manualBind');return {ok:true}}}});
 runInContext(source.slice(start,end),ctx);ctx.url=url;let result=await runInContext('reconcileQueuedGoalResume(7,url)',ctx);return {result,x};
}
{const {x}=await run();assert.deepEqual(x.calls,['resumeObserved','completion:GOAL_COMPLETE'],'terminal response is considered instead of blindly sending');}
for(const mutate of [(x:any)=>x.ready.idle=false,(x:any)=>x.native.generating=true,(x:any)=>x.native.turnStatus='in_progress',(x:any)=>x.goal.stopRequested=true,(x:any)=>x.goal.pauseRequested=true,(x:any)=>x.receipt.requestId='',(x:any)=>x.receipt.startedAt=undefined,(x:any)=>x.receipt.submittedUserId='other',(x:any)=>{x.journal.events.push({kind:'request.started',tabId:7,sourceUrl:url,sequence:2});x.journal.meta.sequence=2},(x:any)=>x.route='https://chatgpt.com/c/other']){const {x}=await run(mutate);assert.deepEqual(x.calls,[],'uncertain, stale, busy or stopped chat cannot dispatch');}
{const {x}=await run(x=>{x.goal.expectedPromptKey='/c/queued|old';x.journal.events.push({kind:'retry.preparation_superseded',tabId:7,sourceUrl:url,requestId:'request',startedAt:100000,sequence:2});x.journal.meta.sequence=2});assert.deepEqual(x.calls,['manual','manualBind','completion:GOAL_COMPLETE'],'newer proven manual turn is bound before completion');}
{const {x}=await run(x=>{x.goal.expectedPromptKey='/c/queued|old';x.journal.events[0].sequence=101;x.journal.events.push({kind:'retry.preparation_superseded',tabId:7,sourceUrl:url,requestId:'request',startedAt:100000,sequence:102},{kind:'request.completed',tabId:7,sourceUrl:url,requestId:'request',sequence:103});x.journal.meta.sequence=103});assert.deepEqual(x.calls,['manual','manualBind','completion:GOAL_COMPLETE'],'retained gap-free suffix permits recovery without older journal history');}
