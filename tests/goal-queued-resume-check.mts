import assert from 'node:assert/strict';import{readFileSync}from'node:fs';import{createContext,runInContext}from'node:vm';
const source=readFileSync('extension/service-worker.js','utf8'),start=source.indexOf('async function reconcileQueuedGoalResume('),end=source.indexOf('async function reconcileAcceptedHandoffGoal(',start);assert.ok(start>0&&end>start);
const url='https://chatgpt.com/c/queued',prompt='/c/queued|current';
